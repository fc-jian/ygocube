# YGO Cube workspace root: runtime / environment artifacts never committed

# runtime state
config.yaml
data/
cube/apps/api/data/
envs/
test_tournaments/
test_deck.ydk
*.log

# tooling dirs
.omo/
.agents/
.DS_Store
.card-resource-sync/
__pycache__/

# node
node_modules/

# build output
cube/apps/api/dist/
cube/apps/web/.next/
cube/apps/web/out/
cube/packages/*/dist/
*.tsbuildinfo

# Local card database, scripts, expansions, pictures, and generated thumbnails.
# These assets are provisioned separately and are intentionally not tracked.
/assets/
